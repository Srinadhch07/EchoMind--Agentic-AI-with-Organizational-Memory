# Base URL of the EchoMind FastAPI backend.
# Leave empty to use the Vite dev-server proxy (default), which forwards /api to
# http://127.0.0.1:8000. Set a full origin (e.g. https://api.example.com) to call
# a deployed backend directly — the backend must allow this origin via CORS.
VITE_API_BASE_URL=
