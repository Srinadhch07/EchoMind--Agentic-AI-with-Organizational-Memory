# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit real keys.

# --- Groq LLM API ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Hindsight memory API ---
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=echomind-support

# --- App ---
APP_NAME=EchoMind
DEBUG=false
API_PREFIX=/api
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Testimonials (public "Why EchoMind" page) ---
# Standard-library SQLite file. No database server required.
TESTIMONIAL_DB_PATH=backend/data/testimonials.db
# Shared secret needed to review or approve submissions.
# Leave empty to keep moderation disabled; submissions are then always pending
# and never appear publicly.
TESTIMONIAL_ADMIN_KEY=

# --- Admin control plane (organization dashboard) ---
# All three of ADMIN_USERNAME, ADMIN_SECRET_KEY and one password source are
# required. If any is missing, every /api/admin/* route returns 503 rather than
# opening up. Sign in at /admin/login, then /organization becomes reachable.

# The single administrator account.
ADMIN_USERNAME=

# HMAC signing key for the session token (HS256). Generate a long random value,
# for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET_KEY=

# PREFERRED. PBKDF2-HMAC-SHA256 hash, so the plaintext is never stored.
# Generate one with:  python -m app.services.admin_auth
ADMIN_PASSWORD_HASH=

# FALLBACK, used only when ADMIN_PASSWORD_HASH is empty. Plaintext, compared in
# constant time. Convenient, but the hash above is better.
ADMIN_PASSWORD=

# Session lifetime in minutes, and whether to add the Secure cookie flag (HTTPS).
ADMIN_SESSION_MINUTES=480
ADMIN_COOKIE_SECURE=false
